#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
HHY Web 0.1.0

Usage:
  hhy-web run <app.hhy> [--port PORT] [--dev]
  hhy-web check <app.hhy>
  hhy-web version
EOF
}

command_name="${1:-}"
case "$command_name" in
    run)
        shift
        app="${1:-}"
        [ -n "$app" ] || { usage >&2; exit 2; }
        shift
        port=8000
        dev=""
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --port) shift; port="${1:-}" ;;
                --dev) dev="--dev" ;;
                *) echo "hhy-web: unknown option: $1" >&2; exit 2 ;;
            esac
            shift
        done
        if [ -n "$dev" ]; then
            exec hhy serve --dev "$app" -- "$port"
        fi
        exec hhy serve "$app" -- "$port"
        ;;
    check)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        exec hhy check "$2"
        ;;
    version)
        echo "HHY Web 0.1.0"
        ;;
    *)
        usage
        [ -z "$command_name" ] || exit 2
        ;;
esac
